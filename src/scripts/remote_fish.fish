cd; and read -l t; and begin; if test "$t" = "~"; set t "$HOME"; else if string match -q "~/*" -- "$t"; set t "$HOME/"(string sub -s 3 -- "$t"); end; end; and set -l d (dirname "$t"); and mkdir -p "$d"; and chmod 700 "$d"; and begin; if test -s "$t"; and test -n (tail -c 1 "$t" | string collect); echo >> "$t"; end; end; and while read -l k; echo "$k" >> "$t"; end; and chmod 600 "$t"
